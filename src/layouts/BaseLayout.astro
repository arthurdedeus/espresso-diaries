---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Espresso Diaries', description = 'Notes from learning espresso and pouring milk.' } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title === 'Espresso Diaries' ? title : `${title} · Espresso Diaries`}</title></head>
<body><a class="skip" href="#content">Skip to content</a><header class="site-header"><a class="wordmark" href="/"><span class="cup" aria-hidden="true"></span>Espresso Diaries</a><nav aria-label="Primary"><a href="/" aria-current={current('/') ? 'page' : undefined}>Journal</a><a href="/beans/" aria-current={current('/beans') ? 'page' : undefined}>Beans</a><a href="/about/" aria-current={current('/about') ? 'page' : undefined}>About</a></nav></header><main id="content"><slot/></main><footer><span>Espresso Diaries</span><span>Made slowly, one cup at a time.</span></footer></body></html>
