---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import RecipeLine from '../components/RecipeLine.astro';
import { formatDatePt, formatDateEn } from '../lib/coffee';
const posts = (await getCollection('posts')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout><section class="intro"><p class="eyebrow" data-pt="Um diário pessoal de café" data-en="A personal coffee journal">Um diário pessoal de café</p><h1><span data-pt="Notas sobre aprender espresso" data-en="Notes from learning espresso">Notas sobre aprender espresso</span><br/><span data-pt="e desenhar com leite." data-en="and pouring milk.">e desenhar com leite.</span></h1><p data-pt="Pequenos ajustes, tulipas imperfeitas e as xícaras que vale lembrar." data-en="Small adjustments, imperfect tulips, and the cups worth remembering.">Pequenos ajustes, tulipas imperfeitas e as xícaras que vale lembrar.</p></section>
<section class="journal" aria-label="Entradas do diário">{posts.map((post,index) => <article class="entry"><time datetime={post.data.date.toISOString()} data-pt={formatDatePt.format(post.data.date)} data-en={formatDateEn.format(post.data.date)}>{formatDatePt.format(post.data.date)}</time><a class="entry-image" href={`/posts/${post.id}/`} aria-label={`Ler ${post.data.titlePt}`}>{post.data.heroImage ? <img src={post.data.heroImage} alt=""/> : <PhotoPlaceholder label="Espaço para a foto deste café" variant={(index%3)+1}/>}</a><div class="entry-copy"><p class="bean-name">{post.data.coffee.beans}</p><h2><a href={`/posts/${post.id}/`} data-pt={post.data.titlePt} data-en={post.data.title}>{post.data.titlePt}</a></h2><RecipeLine dose={post.data.coffee.dose} yieldAmount={post.data.coffee.yield} time={post.data.coffee.extractionTime}/><p class="excerpt" data-pt={post.data.excerptPt} data-en={post.data.excerpt}>{post.data.excerptPt}</p><a class="more" href={`/posts/${post.id}/`}><span data-pt="Ler esta entrada" data-en="Read this entry">Ler esta entrada</span> <span aria-hidden="true">→</span></a></div></article>)}</section></BaseLayout>
