---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import RecipeLine from '../components/RecipeLine.astro';
import { formatDate } from '../lib/coffee';
const posts = (await getCollection('posts')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout><section class="intro"><p class="eyebrow">A personal coffee journal</p><h1>Notes from learning espresso<br/>and pouring milk.</h1><p>Small adjustments, imperfect tulips, and the cups worth remembering.</p></section>
<section class="journal" aria-label="Journal entries">{posts.map((post,index) => <article class="entry"><time datetime={post.data.date.toISOString()}>{formatDate.format(post.data.date)}</time><a class="entry-image" href={`/posts/${post.id}/`} aria-label={`Read ${post.data.title}`}>{post.data.heroImage ? <img src={post.data.heroImage} alt=""/> : <PhotoPlaceholder label="A place for today's coffee" variant={(index%3)+1}/>}</a><div class="entry-copy"><p class="bean-name">{post.data.coffee.beans}</p><h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2><RecipeLine dose={post.data.coffee.dose} yieldAmount={post.data.coffee.yield} time={post.data.coffee.extractionTime}/><p class="excerpt">{post.data.excerpt}</p><a class="more" href={`/posts/${post.id}/`}>Read this entry <span aria-hidden="true">→</span></a></div></article>)}</section></BaseLayout>
