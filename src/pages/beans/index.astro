---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { beanSlug, recipe } from '../../lib/coffee';
const posts = await getCollection('posts');
const groups = Object.values(posts.reduce((r,p) => { const n=p.data.coffee.beans; r[n]??={name:n,origin:p.data.coffee.origin,posts:[]}; r[n].posts.push(p); return r; }, {} as Record<string,{name:string;origin?:string;posts:typeof posts}>));
---
<BaseLayout title="Grãos"><section class="beans-page"><p class="eyebrow" data-pt="Grãos" data-en="Beans">Grãos</p><h1><span data-pt="Cada café conta" data-en="Every coffee tells">Cada café conta</span><br/><span data-pt="uma história diferente." data-en="a different story.">uma história diferente.</span></h1><p class="lede" data-pt="Os grãos com os quais venho aprendendo e as receitas que revelaram o melhor de cada um." data-en="The beans I have been learning with, and the recipes that brought them into focus.">Os grãos com os quais venho aprendendo e as receitas que revelaram o melhor de cada um.</p><div class="bean-list">{groups.map(g => <article><div><p class="bean-origin">{g.origin ?? 'Origem não informada'}</p><h2><a href={`/beans/${beanSlug(g.name)}/`}>{g.name}</a></h2><p><span>{g.posts.length}</span> <span data-pt={g.posts.length===1?'extração':'extrações'} data-en={g.posts.length===1?'extraction':'extractions'}>{g.posts.length===1?'extração':'extrações'}</span></p></div><ul>{g.posts.map(p => <li><span data-pt={p.data.titlePt} data-en={p.data.title}>{p.data.titlePt}</span><span>{recipe(p.data.coffee.dose,p.data.coffee.yield,p.data.coffee.extractionTime)}</span></li>)}</ul></article>)}</div></section></BaseLayout>
