---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeLine from '../../components/RecipeLine.astro';
import { beanSlug, formatDatePt, formatDateEn } from '../../lib/coffee';
export async function getStaticPaths(){const posts=await getCollection('posts');const names=[...new Set(posts.map(p=>p.data.coffee.beans))];return names.map(name=>({params:{slug:beanSlug(name)},props:{name,posts:posts.filter(p=>p.data.coffee.beans===name)}}));}
const {name,posts}=Astro.props; const newest=posts[0];
---
<BaseLayout title={name}><section class="bean-detail"><a class="back" href="/beans/" data-pt="← Todos os grãos" data-en="← All beans">← Todos os grãos</a><p class="eyebrow">{newest.data.coffee.origin ?? 'Notas do café'}</p><h1>{name}</h1>{newest.data.coffee.roaster&&<p class="lede"><span data-pt="Torra de" data-en="Roasted by">Torra de</span> {newest.data.coffee.roaster}</p>}<div class="attempt-list">{posts.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).map(p=><article><time datetime={p.data.date.toISOString()} data-pt={formatDatePt.format(p.data.date)} data-en={formatDateEn.format(p.data.date)}>{formatDatePt.format(p.data.date)}</time><h2><a href={`/posts/${p.id}/`} data-pt={p.data.titlePt} data-en={p.data.title}>{p.data.titlePt}</a></h2><RecipeLine dose={p.data.coffee.dose} yieldAmount={p.data.coffee.yield} time={p.data.coffee.extractionTime}/><p data-pt={p.data.excerptPt} data-en={p.data.excerpt}>{p.data.excerptPt}</p></article>)}</div></section></BaseLayout>
