---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import RecipeLine from '../../components/RecipeLine.astro';
import { beanSlug, formatDatePt, formatDateEn, ratio } from '../../lib/coffee';
export async function getStaticPaths(){const posts=await getCollection('posts');return posts.map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post); const {coffee,milk,equipment,latteArt}=post.data;
---
<BaseLayout title={post.data.titlePt} description={post.data.excerptPt}><article class="post-page"><header class="post-header"><a class="back" href="/" data-pt="← Diário" data-en="← Journal">← Diário</a><time datetime={post.data.date.toISOString()} data-pt={formatDatePt.format(post.data.date)} data-en={formatDateEn.format(post.data.date)}>{formatDatePt.format(post.data.date)}</time><h1 data-pt={post.data.titlePt} data-en={post.data.title}>{post.data.titlePt}</h1><RecipeLine dose={coffee.dose} yieldAmount={coffee.yield} time={coffee.extractionTime}/></header>{post.data.heroImage?<img class="post-hero" src={post.data.heroImage} alt=""/>:<PhotoPlaceholder class="post-hero" label="A foto desta xícara entra aqui" variant={2}/>} {post.data.pullQuote&&<blockquote data-pt={post.data.pullQuotePt ?? post.data.pullQuote} data-en={post.data.pullQuote}>{post.data.pullQuotePt ?? post.data.pullQuote}</blockquote>}
<section class="session-data" aria-label="Detalhes da sessão"><div><h2>Espresso</h2><dl><dt data-pt="Dose" data-en="Dose">Dose</dt><dd>{coffee.dose} g</dd><dt data-pt="Bebida" data-en="Yield">Bebida</dt><dd>{coffee.yield} g</dd>{coffee.extractionTime !== undefined&&<><dt data-pt="Tempo" data-en="Time">Tempo</dt><dd>{coffee.extractionTime} s</dd></>}<dt data-pt="Proporção" data-en="Ratio">Proporção</dt><dd>{ratio(coffee.dose,coffee.yield)}</dd>{coffee.grind&&<><dt data-pt="Moagem" data-en="Grind">Moagem</dt><dd>{coffee.grind}</dd></>}</dl></div>{milk&&<div><h2 data-pt="Leite" data-en="Milk">Leite</h2><dl>{milk.amount&&<><dt data-pt="Quantidade" data-en="Amount">Quantidade</dt><dd>{milk.amount} ml</dd></>}{milk.type&&<><dt data-pt="Tipo" data-en="Type">Tipo</dt><dd data-pt={milk.typePt ?? milk.type} data-en={milk.type}>{milk.typePt ?? milk.type}</dd></>}{milk.temperature&&<><dt data-pt="Temperatura" data-en="Temp.">Temperatura</dt><dd>{milk.temperature} °C</dd></>}{latteArt?.pattern&&<><dt data-pt="Desenho" data-en="Pattern">Desenho</dt><dd data-pt={latteArt.patternPt ?? latteArt.pattern} data-en={latteArt.pattern}>{latteArt.patternPt ?? latteArt.pattern}</dd></>}</dl></div>}<div><h2 data-pt="Equipamento" data-en="Setup">Equipamento</h2><dl><dt data-pt="Grãos" data-en="Beans">Grãos</dt><dd><a href={`/beans/${beanSlug(coffee.beans)}/`}>{coffee.beans}</a></dd>{coffee.roaster&&<><dt data-pt="Torrefação" data-en="Roaster">Torrefação</dt><dd>{coffee.roaster}</dd></>}{equipment?.machine&&<><dt data-pt="Máquina" data-en="Machine">Máquina</dt><dd>{equipment.machine}</dd></>}{equipment?.grinder&&<><dt data-pt="Moedor" data-en="Grinder">Moedor</dt><dd>{equipment.grinder}</dd></>}</dl></div></section><div class="post-body" data-lang-content="pt">{post.data.storyPt.map((paragraph) => <p>{paragraph}</p>)}</div><div class="post-body" data-lang-content="en" hidden><Content/></div>{post.data.images.length>0&&<section class="photo-grid" aria-label="Fotografias da sessão">{post.data.images.map(i=><img src={i.src} alt={i.alt} loading="lazy"/>)}</section>}{post.data.nextTime.length>0&&<aside class="next-time"><p class="eyebrow" data-pt="Na próxima" data-en="Next time">Na próxima</p><ul data-lang-content="pt">{post.data.nextTimePt.map(i=><li>{i}</li>)}</ul><ul data-lang-content="en" hidden>{post.data.nextTime.map(i=><li>{i}</li>)}</ul></aside>}</article></BaseLayout>
