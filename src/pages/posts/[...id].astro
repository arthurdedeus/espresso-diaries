---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import RecipeLine from '../../components/RecipeLine.astro';
import { beanSlug, formatDate, ratio } from '../../lib/coffee';
export async function getStaticPaths(){const posts=await getCollection('posts');return posts.map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post); const {coffee,milk,equipment,latteArt}=post.data;
---
<BaseLayout title={post.data.title} description={post.data.excerpt}><article class="post-page"><header class="post-header"><a class="back" href="/">← Journal</a><time datetime={post.data.date.toISOString()}>{formatDate.format(post.data.date)}</time><h1>{post.data.title}</h1><RecipeLine dose={coffee.dose} yieldAmount={coffee.yield} time={coffee.extractionTime}/></header>{post.data.heroImage?<img class="post-hero" src={post.data.heroImage} alt=""/>:<PhotoPlaceholder class="post-hero" label="Today's cup belongs here" variant={2}/>} {post.data.pullQuote&&<blockquote>{post.data.pullQuote}</blockquote>}
<section class="session-data" aria-label="Session details"><div><h2>Espresso</h2><dl><dt>Dose</dt><dd>{coffee.dose} g</dd><dt>Yield</dt><dd>{coffee.yield} g</dd><dt>Time</dt><dd>{coffee.extractionTime} s</dd><dt>Ratio</dt><dd>{ratio(coffee.dose,coffee.yield)}</dd>{coffee.grind&&<><dt>Grind</dt><dd>{coffee.grind}</dd></>}</dl></div>{milk&&<div><h2>Milk</h2><dl>{milk.amount&&<><dt>Amount</dt><dd>{milk.amount} ml</dd></>}{milk.type&&<><dt>Type</dt><dd>{milk.type}</dd></>}{milk.temperature&&<><dt>Temp.</dt><dd>{milk.temperature} °C</dd></>}{latteArt?.pattern&&<><dt>Pattern</dt><dd>{latteArt.pattern}</dd></>}</dl></div>}<div><h2>Setup</h2><dl><dt>Beans</dt><dd><a href={`/beans/${beanSlug(coffee.beans)}/`}>{coffee.beans}</a></dd>{coffee.roaster&&<><dt>Roaster</dt><dd>{coffee.roaster}</dd></>}{equipment?.machine&&<><dt>Machine</dt><dd>{equipment.machine}</dd></>}{equipment?.grinder&&<><dt>Grinder</dt><dd>{equipment.grinder}</dd></>}</dl></div></section><div class="post-body"><Content/></div>{post.data.images.length>0&&<section class="photo-grid" aria-label="Session photographs">{post.data.images.map(i=><img src={i.src} alt={i.alt} loading="lazy"/>)}</section>}{post.data.nextTime.length>0&&<aside class="next-time"><p class="eyebrow">Next time</p><ul>{post.data.nextTime.map(i=><li>{i}</li>)}</ul></aside>}</article></BaseLayout>
